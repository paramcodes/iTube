{
  "name": "itube",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "build": "bun run --filter='*' build",
    "test": "bun test packages/ apps/",
    "test:e2e": "playwright test",
    "check": "biome check packages/ apps/api/src apps/web/src",
    "format": "biome format --write packages/ apps/api/src apps/web/src"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
